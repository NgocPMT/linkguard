        <mxCell id="tg" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Telegram&lt;/b&gt; &lt;span style=&quot;font-size: 10px; opacity: 0.9;&quot;&gt;[External System]&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Telegram Bot API&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="group_channels">
          <mxGeometry x="35" y="60" width="260" height="65" as="geometry" />
        </mxCell>

        <mxCell id="dc" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Discord&lt;/b&gt; &lt;span style=&quot;font-size: 10px; opacity: 0.9;&quot;&gt;[External System]&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Discord Webhook API&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="group_channels">
          <mxGeometry x="35" y="140" width="260" height="65" as="geometry" />
        </mxCell>

        <mxCell id="sl" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Slack&lt;/b&gt; &lt;span style=&quot;font-size: 10px; opacity: 0.9;&quot;&gt;[External System]&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Incoming Webhooks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="group_channels">
          <mxGeometry x="35" y="220" width="260" height="65" as="geometry" />
        </mxCell>

        <!-- External Relationships with Scaled Dynamic Clearance -->
        <!-- Admin -> Proxy -->
        <mxCell id="rel_ext1" value="Accesses dashboard&lt;br/&gt;&lt;b&gt;[HTTPS]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#707070;strokeWidth=2;endArrow=classic;endFill=1;labelBackgroundColor=none;fontColor=#333333;fontSize=11;" edge="1" parent="1" source="admin" target="proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Proxy -> WebApp -->
        <mxCell id="rel_ext2" value="Proxies requests with headers&lt;br/&gt;&lt;b&gt;[HTTP / 127.0.0.1]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#707070;strokeWidth=2;endArrow=classic;endFill=1;labelBackgroundColor=none;fontColor=#333333;fontSize=11;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="1" source="proxy" target="webApp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Engine -> Target Websites -->
        <mxCell id="rel_ext3" value="Probes hyperlinks with rate limiting&lt;br/&gt;&lt;b&gt;[HEAD / GET (HTTP/S)]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#707070;strokeWidth=2;endArrow=classic;endFill=1;labelBackgroundColor=none;fontColor=#333333;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="engine" target="targetWeb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dispatcher -> Notification Channels Boundary -->
        <mxCell id="rel_ext4" value="Dispatches alerts to enabled channels&lt;br/&gt;&lt;b&gt;[HTTPS / Webhook]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#707070;strokeWidth=2;endArrow=classic;endFill=1;labelBackgroundColor=none;fontColor=#333333;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dispatcher" target="boundary_channels">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

